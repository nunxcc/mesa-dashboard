{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety.
       `exactOptionalPropertyTypes` is deliberately off: JSX passes `undefined`
       for every omitted prop, so it would force `| undefined` onto virtually
       every optional prop in the codebase without catching a real defect.
       The flags that do earn their keep here are kept on. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths. No `baseUrl`: it is deprecated in TS 6, and since 5.0 `paths`
       resolves relative to this file, which is what we want anyway. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
